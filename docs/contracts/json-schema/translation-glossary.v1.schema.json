{
  "$defs": {
    "AssetLifecycleStatus": {
      "description": "Preparation lifecycle for context and glossary revisions.",
      "enum": [
        "draft",
        "ready"
      ],
      "title": "AssetLifecycleStatus",
      "type": "string"
    },
    "CanonicalEvidenceEntry": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CanonicalEvidenceKind"
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "type": "string"
        },
        "pts_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "resource_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "media_type",
        "resource_digest",
        "locator"
      ],
      "type": "object"
    },
    "CanonicalEvidenceKind": {
      "description": "External evidence resource category.",
      "enum": [
        "frame",
        "image",
        "text"
      ],
      "title": "CanonicalEvidenceKind",
      "type": "string"
    },
    "CanonicalEvidenceManifest": {
      "additionalProperties": false,
      "properties": {
        "base_uri": {
          "minLength": 1,
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/CanonicalEvidenceEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "base_uri",
        "entries"
      ],
      "type": "object"
    },
    "DocumentReference": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "revision_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "revision_id",
        "content_digest"
      ],
      "type": "object"
    },
    "GlossaryDecisionStatus": {
      "description": "Authority level for one glossary decision.",
      "enum": [
        "verified",
        "human_selected",
        "unresolved"
      ],
      "title": "GlossaryDecisionStatus",
      "type": "string"
    },
    "GlossaryEntry": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "decision_status": {
          "$ref": "#/$defs/GlossaryDecisionStatus"
        },
        "entry_id": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "instruction": {
          "minLength": 1,
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "type": "string"
        },
        "preferred_target": {
          "minLength": 1,
          "type": "string"
        },
        "scope_source_cue_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "source_variants": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/GlossaryEntryType"
        }
      },
      "required": [
        "entry_id",
        "source_variants",
        "type",
        "scope_source_cue_ids",
        "decision_status",
        "blocking",
        "case_sensitive",
        "evidence_ids"
      ],
      "type": "object"
    },
    "GlossaryEntryType": {
      "description": "Closed translation glossary category.",
      "enum": [
        "person_name",
        "nickname",
        "work_title",
        "song_title",
        "organization",
        "place",
        "food",
        "technical_term",
        "phonetic_expression",
        "wordplay",
        "contextual_translation"
      ],
      "title": "GlossaryEntryType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "minLength": 1,
      "type": "string"
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/GlossaryEntry"
      },
      "type": "array"
    },
    "evidence": {
      "$ref": "#/$defs/CanonicalEvidenceManifest"
    },
    "lifecycle_status": {
      "$ref": "#/$defs/AssetLifecycleStatus"
    },
    "prepared_from_source_ref": {
      "$ref": "#/$defs/DocumentReference"
    },
    "record_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "revision_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "translation-glossary.v1",
      "type": "string"
    },
    "supersedes_revision_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "revision_id",
    "content_digest",
    "record_digest",
    "lifecycle_status",
    "prepared_from_source_ref",
    "evidence",
    "entries"
  ],
  "type": "object"
}
